% makes period custom-styled iff there's no `thmnote`/theorem name, as name is left unstyled
% and going from styled theorem number to unstyled theorem name back to styled ending punct is kinda weird
% the 3 params are theorem type (e.g. `Theorem` vs. `Definition`), theorem counter, and theorem name
\newcommand{\thmheadingformat}[3]{%
    \thmname{#1}\@ifempty{#2}{}{\ }%
    \thmnumber{#2}%
    {%
        \thmnote{%
            \unboldmath\normalfont{\@ifempty{#3}{}{\ (#3)}}%
        }%
    }%
    \@ifempty{#3}{.}{.}%
}


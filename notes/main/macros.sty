\newtheoremstyle{thm}
    {2.5\parskip}                   % space above
    {1.5\parskip}                   % space below
    {\normalfont}                   % body font style
    {0pt}                           % heading indent
    {\boldmath\bfseries}            % heading font style
    {}                              % heading end punctuation
    {5pt plus 1pt minus 1pt}        % horizontal space after heading end punct and before thm body
    {\thmheadingformat{#1}{#2}{#3}} % heading format

\newtheoremstyle{rmk}
    {2.5\parskip}
    {1.5\parskip}
    {\normalfont\color{dimgray}}
    {0pt}
    {\boldmath\bfseries}
    {.}
    {5pt plus 1pt minus 1pt}
    {}

\newtheoremstyle{pf}
    {2.5\parskip}
    {1.5\parskip}
    {\normalfont}
    {0pt}
    {\boldmath\bfseries}
    {.}
    {5pt plus 1pt minus 1pt}
    {%
        \thmname{%
            \@ifempty{#3}{#1}{#3}%
        }%
    }

\newtcolorbox{thmbox}[1][custompink]{%
    breakable,
    enhanced,
    parbox=false, % prevents `\parskip` from being reset inside the box
    before skip balanced=2.5\parskip,
    after skip balanced=2.5\parskip,
    boxrule=2.5pt,
    arc=2pt,
    colframe=#1,
    colback=white,
    top=0.5em,
    left=0.75em,
    bottom=0.5em,
    right=0.75em%
}

\newtcolorbox{pfbox}[1][lightgray]{%
    breakable,
    enhanced,
    parbox=false,
    before skip balanced=2.5\parskip,
    after skip balanced=2.5\parskip,
    frame hidden,
    borderline west={2.5pt}{0pt}{#1},
    colback=white,
    boxsep=0em,
    top=0em,
    left=1em,
    bottom=0em,
    right=0em%
}

\newtcolorbox{impt}{%
    breakable,
    enhanced,
    parbox=false,
    before skip balanced=2.5\parskip,
    after skip balanced=2.5\parskip,

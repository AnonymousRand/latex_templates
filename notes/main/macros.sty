\theoremstyle{thm}

% the `subsection` here means that theorem counters' penultimate unit is the subsection
% i.e. `section.subsection.theorem`
\newtheorem{thminner}{Theorem}[subsection]
\newtheorem*{thminner*}{Theorem}
\newenvironment{thm}[1][]{%
    \begin{thmbox}%
        \begin{thminner}[#1]%
}{%
        \end{thminner}%
    \end{thmbox}%
}
\newenvironment{thm*}[1][]{%
    \begin{thmbox}%
        \begin{thminner*}[#1]%
}{%
        \end{thminner*}%
    \end{thmbox}%
}

% the `thminner` here means that corollary counters are shared with `thminner`s
% i.e. don't start at "Corollary 1.1.1"  after "Theorem 1.1.3"; instead do "Corollary 1.1.4"

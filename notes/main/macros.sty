    borderline south={4pt}{0pt}{customblue},
    borderline west={4pt}{0pt}{custompink},
    colback=white,
    top=0.75em,
    left=1em,
    bottom=0.75em,
    right=1em%
}

\newtcolorbox{algorithmbox}{%

% Use this if ending proof in display math mode or nested environment to make QED not go onto next line.
%
% Prerequisites:
%    - No other `\tag` is being used on last line of equation
\newcommand{\qedinside}{%
    \relax\ifmmode%
        \tag*{\qedhere}%
    \else%
        \qedhere%
    \fi%
}

% Column/row vectors with parentheses.
%
% Usage:
%    - `\vect{}{}...\vend`
%    - `\rvect{}{}...\rend`
%
% (Who knew my Assembly class would be useful for implementing a while loop in LaTeX?)
\newcommand{\vect}[1]{\begin{pmatrix} #1 \@vectorcheck}     % starts first row and checks for more
\newcommand\@vectorcheck{%                                  % branch dependending on if `\vend` is read
    \@ifnextchar\vend{%
        \@vectorend%
    }{%
        \@vectorrow%
    }%
}
\newcommand\@vectorrow[1]{\\ #1 \@vectorcheck}              % prints a row and checks for more
\newcommand\@vectorend{\end{pmatrix}}                       % ends the column vector
\newcommand{\vend}{}

\newcommand{\rvect}[1]{\begin{pmatrix} #1 \@rowvectorcheck} % same thing but for row matrices
\newcommand\@rowvectorcheck{%
    \@ifnextchar\rvend{%
        \@rowvectorend%
    }{%
        \@rowvectorcolumn%
    }%
}
\newcommand\@rowvectorcolumn[1]{& #1 \@rowvectorcheck}
\newcommand\@rowvectorend{\end{pmatrix}}
\newcommand{\rvend}{}

% Natural transformation "visual" notation.
%
% Params: `\nattrans[#1]{#2}{#3}{#4}{#5}{#6}`
%    - #1: optional; spacing between source and destination categories (default: 4em)
%    - #2: source category of functors
%    - #3: destination category of functors
%    - #4: source functor
%    - #5: destination functor
%    - #6: name of natural transformation
%
%    For example, `\nattrans[1pt]{\mathcal{C}}{\mathcal{D}}{F}{G}{\alpha}`
%    denotes a natural transformation `\alpha: F \to G` where `F` and `G` are functors `C \to D`,
%    with 1pt of spacing between `C` and `D`
\newcommand{\nattrans}[6][4em]{%
    \begin{tikzcd}[ampersand replacement=\&, column sep=#1]
        #2
            \ar[r, ""{name=top}, "#4", bend left=50]
            \ar[r, ""{name=bot}, "#5"', bend right=50] \&
        #3
            \ar[Rightarrow, shorten <=8pt, shorten >=2pt, to path={
                (top) -- node[label={[xshift=-0.3em]right:\(#6\)}] {} (bot)
            }]{}
    \end{tikzcd}%
}

